{
  "schema_version":"SWISS-VACANCY-DRAFT-3.0",
  "authority_effect":"NONE",
  "description":"Research contract for multi-source Swiss vacancy normalization. Not yet production schema authority.",
  "required_identity_fields":["vacancy_id","source_record_ids","canonical_role_id","employer_id","first_seen","last_verified","status"],
  "fields":{
    "vacancy_id":{"type":"string","semantics":"canonical vacancy identity; never source URL identity"},
    "source_record_ids":{"type":"array[string]","minItems":1},
    "employer_id":{"type":"string"},
    "employer_location_id":{"type":["string","null"]},
    "niche_id":{"type":"string","pattern":"^NICHE-[0-9]{3}$"},
    "occupation_family_id":{"type":"string"},
    "canonical_role_id":{"type":"string"},
    "raw_title":{"type":"string"},
    "normalized_title":{"type":"string"},
    "canton_code":{"type":["string","null"],"allowed":["AG","AI","AR","BE","BL","BS","FR","GE","GL","GR","JU","LU","NE","NW","OW","SG","SH","SO","SZ","TG","TI","UR","VD","VS","ZG","ZH",null]},
    "municipality":{"type":["string","null"]},
    "postal_code":{"type":["string","null"]},
    "country":{"const":"CH"},
    "workplace_mode":{"allowed":["ONSITE","HYBRID","REMOTE_CH","REMOTE_INTL","UNKNOWN"]},
    "contract_type":{"allowed":["PERMANENT","FIXED_TERM","TEMPORARY","SEASONAL","APPRENTICESHIP","INTERNSHIP","FREELANCE","ON_CALL","UNKNOWN"]},
    "employment_pct_min":{"type":["number","null"],"minimum":0,"maximum":100},
    "employment_pct_max":{"type":["number","null"],"minimum":0,"maximum":100},
    "hours_per_week":{"type":["number","null"]},
    "start_date":{"type":["date","null"]},
    "start_date_semantics":{"allowed":["EXACT","APPROXIMATE","ASAP","BY_AGREEMENT","SEASON_START","UNKNOWN"]},
    "end_date":{"type":["date","null"]},
    "experience_required":{"allowed":["NONE_EXPLICIT","PREFERRED","REQUIRED","UNKNOWN"]},
    "experience_years_min":{"type":["number","null"]},
    "education_required":{"type":"array[assertion]"},
    "certifications_required":{"type":"array[assertion]"},
    "driving_license":{"type":"array[assertion]"},
    "skills_required":{"type":"array[assertion]"},
    "language_requirements":{"type":"array[LanguageRequirement]"},
    "salary":{"type":["SalaryAssertion","null"]},
    "benefits":{"type":"array[BenefitAssertion]"},
    "housing":{"type":["HousingAssertion","null"]},
    "meals":{"type":["BenefitAssertion","null"]},
    "shift_requirements":{"type":"array[string]"},
    "weekend_required":{"type":["boolean","null"]},
    "night_required":{"type":["boolean","null"]},
    "work_authorization_text":{"type":["string","null"]},
    "application_channel":{"type":"array[ChannelRef]"},
    "posting_url":{"type":["string","null"],"note":"source URL; never canonical identity"},
    "employer_careers_url":{"type":["string","null"]},
    "published_at":{"type":["datetime","null"]},
    "first_seen":{"type":"datetime"},
    "last_seen":{"type":"datetime"},
    "last_verified":{"type":"datetime"},
    "fresh_until":{"type":["datetime","null"]},
    "status":{"allowed":["DISCOVERED","NORMALIZED","DEDUP_CANDIDATE","CANONICAL_REVIEWED","LIVE_VERIFIED","FILLED","EXPIRED","WITHDRAWN","UNKNOWN_AFTER_SEARCH"]},
    "provenance":{"type":"array[EvidenceRef]"},
    "normalizer_version":{"type":"string"},
    "content_fingerprint":{"type":"sha256"}
  },
  "LanguageRequirement":{
    "language":{"allowed":["DE","FR","IT","RM","EN","ES","OTHER"]},
    "level":{"allowed":["A1","A2","B1","B2","C1","C2","NATIVE","FLUENT_UNSCALED","WORKING_UNSCALED","BASIC_UNSCALED","NOT_STATED"]},
    "importance":{"allowed":["MANDATORY","PREFERRED","WORKING_LANGUAGE","ADVANTAGE","UNKNOWN"]},
    "basis":{"allowed":["EXPLICIT_AD","EMPLOYER_CONFIRMATION","DERIVED_FROM_PRIMARY_ROLE_POLICY","UNKNOWN"]},
    "evidence_ref":{"type":"string"}
  },
  "SalaryAssertion":{
    "class":{"allowed":["DISCLOSED","DERIVED_RULE","MARKET_ESTIMATE"]},
    "currency":{"const":"CHF"},
    "min":{"type":["number","null"]},
    "max":{"type":["number","null"]},
    "period":{"allowed":["HOUR","MONTH","YEAR","SHIFT","UNKNOWN"]},
    "gross_net":{"allowed":["GROSS","NET","UNKNOWN"]},
    "workload_pct_basis":{"type":["number","null"]},
    "thirteenth_salary":{"allowed":["INCLUDED","EXCLUDED","SEPARATE","UNKNOWN"]},
    "applicability":{"type":"string"},
    "observed_at":{"type":"datetime"},
    "evidence_ref":{"type":"string"},
    "confidence":{"type":"number","minimum":0,"maximum":1}
  },
  "HousingAssertion":{
    "availability":{"allowed":["CONFIRMED","POSSIBLE","NOT_AVAILABLE","NOT_STATED","UNKNOWN_AFTER_SEARCH"]},
    "type":{"allowed":["STAFF_ROOM","STAFF_APARTMENT","SHARED_ROOM","EXTERNAL_HELP","OTHER","UNKNOWN"]},
    "cost_chf_month":{"type":["number","null"]},
    "deposit_chf":{"type":["number","null"]},
    "distance_to_work_km":{"type":["number","null"]},
    "evidence_ref":{"type":"string"}
  },
  "BenefitAssertion":{
    "type":{"type":"string"},
    "state":{"allowed":["CONFIRMED","POSSIBLE","NOT_AVAILABLE","NOT_STATED","UNKNOWN_AFTER_SEARCH"]},
    "value":{"type":["string","number","null"]},
    "evidence_ref":{"type":"string"}
  },
  "invariants":[
    "UNKNOWN != NOT_REQUIRED != NOT_STATED",
    "one canonical vacancy may have multiple source records",
    "source URL changes must not automatically create a new canonical vacancy",
    "DISCLOSED salary must have direct vacancy/employer evidence",
    "MARKET_ESTIMATE must never be rendered as employer salary",
    "language CEFR must not be fabricated from posting language",
    "LIVE_VERIFIED requires current primary or qualified source evidence",
    "PACKET_ELIGIBLE is intentionally absent from vacancy state; application eligibility belongs to Opportunity/Application gates",
    "expired vacancy evidence cannot be send-critical",
    "normalization must preserve raw text lineage"
  ]
}