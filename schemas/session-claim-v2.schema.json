{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://swiss-os.local/schemas/session-claim-v2.schema.json","title":"SessionClaimV2","type":"object","additionalProperties":false,"required":["claim_id","session_id","resource_scope","semantic_scope","mode","lease_expires_at","fencing_token","state"],"properties":{"claim_id":{"type":"string","minLength":4},"session_id":{"type":"string","pattern":"^SES:"},"resource_scope":{"type":"string","minLength":1},"semantic_scope":{"type":"string","minLength":1},"mode":{"enum":["READ","WRITE"]},"lease_expires_at":{"type":"string","format":"date-time"},"fencing_token":{"type":"integer","minimum":1},"state":{"enum":["ACTIVE","RELEASED","EXPIRED","SUPERSEDED"]}}}